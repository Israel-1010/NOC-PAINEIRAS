# Copie para .env e preencha localmente. Nao coloque senha no codigo.
PORT=3333

# Enquanto estiver true, a API usa dados falsos mesmo com AD configurado.

# Use LDAPS em producao sempre que possivel.
AD_URL=ldaps://dc01.seudominio.local:636
# Use um certificado valido do DC/CA. Alternativa: informe o CA raiz/intermediario.
AD_TLS_CA_FILE=
# Apenas laboratorio: false ignora certificado expirado/invalido no LDAPS.
AD_TLS_REJECT_UNAUTHORIZED=true
AD_BASE_DN=DC=seudominio,DC=local
AD_BIND_DN=DOMINIO\usuario_servico
AD_BIND_PASSWORD=troque_esta_senha
AD_NETBIOS_DOMAIN=DOMINIO
AD_USE_MOCK=false
APP_SESSION_SECRET=troque_este_segredo

# Opcional: limite buscas em OUs especificas.
AD_USERS_BASE_DN=
AD_COMPUTERS_BASE_DN=
AD_GROUPS_BASE_DN=

# Opcional: dominios adicionais para aparecerem na criacao de usuarios.
AD_EXTRA_DOMAINS=clubepaineiras.com.br

# Opcional: DCs para consultar eventos 4740 de bloqueio via Windows Event Log.
# Requer RPC liberado e permissao para ler o log Security nos DCs.
AD_EVENT_DCS=dc01.seudominio.local,dc02.seudominio.local

# Intune / Microsoft Graph.
# Permissoes iniciais no App Registration:
# DeviceManagementManagedDevices.Read.All, Device.Read.All, User.Read.All
INTUNE_USE_MOCK=true
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# Milvus chamados.
# Ajuste os paths conforme a documentacao do portal developers.milvus.com.br.
MILVUS_USE_MOCK=true
MILVUS_BASE_URL=
MILVUS_API_TOKEN=
MILVUS_AUTH_HEADER=Authorization
MILVUS_AUTH_SCHEME=
MILVUS_TICKETS_PATH=/chamado/listagem?total_registros=1000
MILVUS_TICKET_DETAILS_PATH=/chamado/listagem?total_registros=1000
MILVUS_CREATE_TICKET_PATH=/chamado/criar
MILVUS_CLOSE_TICKET_PATH=

# Banco do portal WiFi.
WIFI_DB_HOST=127.0.0.1
WIFI_DB_PORT=3306
WIFI_DB_USER=usuario_wifi
WIFI_DB_PASSWORD=troque_esta_senha
WIFI_DB_NAME=wifi_portal
WIFI_ASSOCIADOS_TABLE=Tb_associados
WIFI_COLABORADORES_TABLE=Tb_colaboradores
